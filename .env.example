
# --- PostgreSQL (Docker và scripts/setup_local_db.py) ---
POSTGRES_USER=reviewinsight
POSTGRES_PASSWORD=change_me
POSTGRES_DB=reviewinsight


# run_local.ps1 tự đổi hai host này thành localhost khi chạy trên máy.
DATABASE_URL=postgresql+psycopg://reviewinsight:change_me@postgres:5432/reviewinsight
REDIS_URL=redis://redis:6379/0

# --- LLM của trợ lý: gemini hoặc groq ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.2

# --- Mô hình ABSA ---
PHOBERT_MODEL_PATH=models/phobert/best_model.pt

# --- Tìm kiếm ngữ nghĩa (pgvector) ---
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_TABLE=opinion_chunks_bge_m3
EMBEDDING_DEVICE=cpu
HYBRID_RETRIEVAL_ENABLED=true
SEMANTIC_MIN_SCORE=0.30
RETRIEVAL_CACHE_TTL_SECONDS=1800
RETRIEVAL_CANDIDATE_LIMIT=40
RETRIEVAL_FINAL_LIMIT=6

# --- Xếp hạng lại (cross-encoder) ---
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# auto: dùng GPU nếu có
RERANKER_DEVICE=auto
RERANKER_TOP_K=40
RERANKER_MIN_SCORE=0.40

# Nạp sẵn embedding và reranker khi khởi động, đặt 0 để tắt
MODEL_WARMUP=1

# --- Đánh giá trợ lý (Ragas) ---
OPENAI_API_KEY=
RAGAS_JUDGE_PROVIDER=openai
RAGAS_JUDGE_MODEL=gpt-4.1-mini-2025-04-14
RAGAS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
